<?php

/**
 * Request Leave Page
 */
session_start();
include '../config.php';

// Check if staff is logged in
if (!isset($_SESSION['staff_id'])) {
    header('Location: login.php');
    exit;
}

$staff_id = $_SESSION['staff_id'];
$message = '';
$message_type = '';

// Get staff information
$staff_query = $conn->prepare("SELECT id, first_name, last_name, email, position FROM staff WHERE id = ?");
$staff_query->bind_param("i", $staff_id);
$staff_query->execute();
$staff = $staff_query->get_result()->fetch_assoc();

if (!$staff) {
    session_destroy();
    header('Location: login.php');
    exit;
}

// Get staff leave balance
$leave_balance_query = $conn->prepare("SELECT available_leave FROM staff_leave_balance WHERE staff_id = ?");
$leave_balance_query->bind_param("i", $staff_id);
$leave_balance_query->execute();
$leave_balance_result = $leave_balance_query->get_result()->fetch_assoc();
$available_leave = $leave_balance_result['available_leave'] ?? 14;

// Get list of staff members for substitute
$staff_list_query = $conn->prepare("SELECT id, first_name, last_name FROM staff WHERE id != ? AND status = 'active' ORDER BY first_name");
$staff_list_query->bind_param("i", $staff_id);
$staff_list_query->execute();
$staff_list = $staff_list_query->get_result()->fetch_all(MYSQLI_ASSOC);

// Handle form submission
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $request_date = $_POST['request_date'] ?? '';
    $start_date = $_POST['start_date'] ?? '';
    $end_date = $_POST['end_date'] ?? '';
    $reason = $_POST['reason'] ?? '';
    $substitute_staff_id = !empty($_POST['substitute_staff_id']) ? $_POST['substitute_staff_id'] : null;
    $supporting_documents = '';

    // Calculate total days
    $start = new DateTime($start_date);
    $end = new DateTime($end_date);
    $total_days = $end->diff($start)->days + 1; // +1 to include end date

    // Validate dates
    if ($start_date >= $end_date) {
        $message = 'Error: End date must be after start date.';
        $message_type = 'danger';
    } elseif ($total_days > $available_leave) {
        $message = "Error: You have requested $total_days days but only $available_leave days are available.";
        $message_type = 'danger';
    } else {
        // Handle file upload if provided
        if (!empty($_FILES['supporting_documents']['name'])) {
            $upload_dir = '../assets/uploads/documents/';
            if (!is_dir($upload_dir)) {
                mkdir($upload_dir, 0755, true);
            }

            $file_name = time() . '_' . basename($_FILES['supporting_documents']['name']);
            $file_path = $upload_dir . $file_name;

            if (move_uploaded_file($_FILES['supporting_documents']['tmp_name'], $file_path)) {
                $supporting_documents = 'documents/' . $file_name;
            }
        }

        // Insert into database
        $insert_query = $conn->prepare(
            "INSERT INTO leave_requests 
             (staff_id, request_date, start_date, end_date, total_days, reason, substitute_staff_id, supporting_documents, status) 
             VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'pending')"
        );
        $insert_query->bind_param(
            "isssisss",
            $staff_id,
            $request_date,
            $start_date,
            $end_date,
            $total_days,
            $reason,
            $substitute_staff_id,
            $supporting_documents
        );

        if ($insert_query->execute()) {
            $message = 'Your request has been submitted successfully and is pending approval. Please await a response from the HR before taking any action.';
            $message_type = 'success';
            $_POST = [];
        } else {
            $message = 'Error submitting request. Please try again.';
            $message_type = 'danger';
        }
    }
}

?>
