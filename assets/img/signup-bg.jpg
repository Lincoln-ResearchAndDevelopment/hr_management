  </defs>
  <rect width="600" height="800" fill="url(#bgGrad2)"/>
  
  <!-- Cathedral/Building silhouettes -->
  <path d="M 80 420 L 110 280 L 140 420 Z" fill="#FFFFFF" opacity="0.16"/>
