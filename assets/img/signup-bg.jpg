  <circle cx="520" cy="180" r="90" fill="#FFFFFF" opacity="0.07"/>
  <circle cx="150" cy="680" r="110" fill="#FFFFFF" opacity="0.06"/>
  <circle cx="480" cy="640" r="80" fill="#FFFFFF" opacity="0.08"/>
  
