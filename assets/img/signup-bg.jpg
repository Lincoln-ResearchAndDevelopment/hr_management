  <path d="M 180 380 L 220 150 L 260 380 Z" fill="#FFFFFF" opacity="0.2"/>
  <rect x="220" y="380" width="40" height="320" fill="#FFFFFF" opacity="0.2"/>
  
  <path d="M 340 400 L 380 230 L 420 400 Z" fill="#FFFFFF" opacity="0.14"/>
