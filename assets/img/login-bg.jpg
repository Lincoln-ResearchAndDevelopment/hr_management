  <path d="M 200 350 L 230 200 L 260 350 Z" fill="#FFFFFF" opacity="0.2"/>
  <rect x="230" y="350" width="30" height="350" fill="#FFFFFF" opacity="0.2"/>
  
  <path d="M 350 380 L 380 250 L 410 380 Z" fill="#FFFFFF" opacity="0.12"/>
