<svg viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg">
  <!-- Gradient background -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFE8EB;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FFF5F5;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="400" fill="url(#bgGradient)"/>
  
  <!-- Workspace with desk and papers -->
  <rect x="40" y="240" width="220" height="140" rx="10" fill="#E8D5C4" opacity="0.6"/>
  
  <!-- Papers on desk -->
  <rect x="60" y="250" width="100" height="80" rx="5" fill="#FFFFFF" transform="rotate(-15 110 290)" opacity="0.8"/>
  <rect x="120" y="280" width="90" height="70" rx="5" fill="#F5F5F5" transform="rotate(10 165 315)"/>
  
  <!-- Pencil/pen -->
  <line x1="180" y1="200" x2="200" y2="280" stroke="#D4A574" stroke-width="4" stroke-linecap="round"/>
  
  <!-- Hand holding pencil -->
  <g>
    <!-- Arm -->
    <ellipse cx="200" cy="140" rx="25" ry="50" fill="#C9A876" transform="rotate(-30 200 140)"/>
    <!-- Hand -->
    <circle cx="210" cy="85" r="18" fill="#D4B5A0"/>
    <!-- Fingers -->
    <ellipse cx="215" cy="75" rx="6" ry="12" fill="#D4B5A0"/>
    <ellipse cx="220" cy="72" rx="5" ry="11" fill="#D4B5A0"/>
  </g>
  
  <!-- Person's head/profile silhouette -->
  <g>
    <!-- Head -->
    <circle cx="120" cy="80" r="35" fill="#8B6F47"/>
    <!-- Hair -->
    <path d="M 85 80 Q 85 40 120 35 Q 155 40 155 80" fill="#6B5540"/>
    <!-- Shoulders -->
    <ellipse cx="120" cy="140" rx="55" ry="35" fill="#8B6F47"/>
  </g>
  
  <!-- Decorative geometric shapes in background -->
  <circle cx="250" cy="60" r="30" fill="#FFD1DC" opacity="0.4"/>
  <rect x="30" y="50" width="40" height="40" fill="none" stroke="#FFB8D1" stroke-width="2" opacity="0.5"/>
</svg>
